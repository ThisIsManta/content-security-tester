{
	"name": "content-security-tester",
	"description": "GitHub Actions for testing Content Security Policy (CSP)",
	"author": "Anantachai Saothong",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "rm -rf dist/* && esbuild main/index.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist",
		"test": "tsc && vitest --root main --coverage --coverage.thresholds.statements 100 --coverage.reporter text --coverage.exclude index.ts"
	},
	"devDependencies": {
		"@actions/core": "^3.0.0",
		"@types/node": "~24.12.0",
		"@vitest/coverage-v8": "^4.1.2",
		"cheerio": "^1.2.0",
		"esbuild": "^0.27.4",
		"lefthook": "^2.1.4",
		"typescript": "^6.0.2",
		"vitest": "^4.1.2"
	}
}
