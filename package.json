{
	"name": "content-security-tester",
	"description": "GitHub Actions for testing Content Security Policy (CSP)",
	"author": "Anantachai Saothong",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "rolldown main/index.ts --clean-dir --file=dist/index.js --format=cjs --platform=node --transform.target=node24",
		"test": "tsc && vitest --root main --coverage --coverage.thresholds.statements 100 --coverage.reporter text --coverage.exclude index.ts"
	},
	"devDependencies": {
		"@actions/core": "^3.0.0",
		"@types/node": "~24.12.2",
		"@vitest/coverage-v8": "^4.1.4",
		"cheerio": "^1.2.0",
		"lefthook": "^2.1.6",
		"rolldown": "*",
		"typescript": "^6.0.3",
		"vite": "^8.0.9",
		"vitest": "^4.1.4"
	}
}